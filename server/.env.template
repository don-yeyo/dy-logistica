# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (DY-LOGISTICA-APP)
# Variables requeridas en Netlify Functions / Entorno Producción
# ==============================================================================

NODE_ENV=production
PORT=5000

# ==============================================================================
# BASE DE DATOS MYSQL (AWS RDS - Gestion_Logistica ERP)
# ==============================================================================
DB_HOST=dydb2-instance-1.cz8kik28igwg.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=Gestion_Logistica
DB_USER=DBAdmin_Glog
DB_PASSWORD=tu_contraseña_glog_aqui
DB_SSL=true
DB_CONNECTION_LIMIT=5
# Cantidad máxima de ítems por UPDATE masivo en lote hacia AWS RDS
DB_BULK_UPDATE_CHUNK_SIZE=200

# Fallback para hojas de ruta sin mapeo/EMail asignado (mantener false en producción)
ALLOW_UNASSIGNED_HR_FALLBACK=false

# Códigos de tipo en REMITO_CAJONES (1 = Entrega, 2 = Devolución)
CAJONES_TIPO_ENTREGA=1
CAJONES_TIPO_DEVOLUCION=2

# Cantidad por defecto de viajes/hojas de ruta a recuperar
MAX_VIAJES_HISTORICOS_DEFAULT=4
MAX_HOJAS_RUTA_LIST=20
UPLOAD_DIR=uploads

# Paginación por defecto y máxima para las grillas del Gestor de Escritorio
ADMIN_DEFAULT_PAGE_SIZE=15
ADMIN_MAX_PAGE_SIZE=100

# Ventana de fechas visible para el chofer en la App Móvil (en días desde hoy)
HOJAS_RUTA_DIAS_ATRAS=1
HOJAS_RUTA_DIAS_ADELANTE=1

# Cantidad mínima de ejemplares esperados para considerar completo un remito (criterio transitorio por cliente)
REMITO_EJEMPLARES_ESPERADOS_DEFAULT=2

# Ventana de días hacia atrás para buscar remitos pendientes de viajes anteriores en el mismo lugar de entrega
REMITOS_LUGAR_DIAS_ATRAS=30

# ==============================================================================
# INTEGRACIÓN MICROSOFT ENTRA ID (AZURE AD SSO)
# ==============================================================================
AZURE_AD_TENANT_ID=fd8a7e94-3179-471f-b79c-a64f8bfc8536
AZURE_AD_CLIENT_ID=8d66bceb-6e2b-4cd7-8ed3-31046f8c22ad
AZURE_AD_CLIENT_SECRET=tu_azure_ad_client_secret_aqui

# ==============================================================================
# INTEGRACIÓN SHAREPOINT & POWER AUTOMATE (FOTOS)
# ==============================================================================
POWERAUTOMATE_URL=https://prod-flow-placeholder
SHAREPOINT_FQDN=https://donyeyo.sharepoint.com
ENABLE_SHAREPOINT_UPLOAD=true

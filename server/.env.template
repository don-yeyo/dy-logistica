# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (DY-LOGISTICA-APP)
# ==============================================================================

# Puerto de escucha del servidor Express
PORT=5000
NODE_ENV=development

# Clave secreta para autorizar peticiones API (Header X-API-Key)
API_SECRET_KEY=dy_logistica_secret_key_2026

# Cantidad por defecto de viajes/hojas de ruta a recuperar por chofer
MAX_VIAJES_HISTORICOS_DEFAULT=4

# Directorio local de almacenamiento temporal/permanente de fotos
UPLOAD_DIR=uploads

# ==============================================================================
# BASE DE DATOS MYSQL (AWS RDS / Local)
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Firma_de_remitos
DB_USER=root
DB_PASSWORD=root

# ==============================================================================
# INTEGRACIÓN MICROSOFT ENTRA ID & SHAREPOINT
# ==============================================================================
# Credenciales Azure AD para autenticación de servicios
AZURE_AD_TENANT_ID=tu_tenant_id_aqui
AZURE_AD_CLIENT_ID=tu_client_id_aqui
AZURE_AD_CLIENT_SECRET=tu_client_secret_aqui

# Endpoint de Power Automate / SharePoint para subir las fotos capturadas
POWERAUTOMATE_URL=https://tu_endpoint_flow_aqui
SHAREPOINT_FQDN=https://tu_sitio.sharepoint.com

# Activar subida automática a SharePoint al recibir foto (true/false)
# Si es false, se almacena en disco local en server/uploads/
ENABLE_SHAREPOINT_UPLOAD=false
